---
---

<nav>
    <div class="right">
        <img src="/logo.png" alt="Strascrous" />
        <h1>Strascrous<span class="highlight">.</span></h1>
    </div>

    <div class="left">
        <a href="#" class="download">Télécharger l'application</a>
        <a href="#features">Fonctionnalités</a>
        <a href="https://github.com/Strascrous">GitHub</a>
    </div>
</nav>

<style lang="scss">
    nav {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        position: fixed;
        top: 32px;
        width: calc(80% - 24px * 2);

        background: $fg;
        border-radius: 48px;
        padding: 16px 24px;
        *:not(.highlight) {
            color: $invert-fg;
        }

        .right {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 12px;

            img {
                height: 48px;
                width: 48px;
            }

            h1, h1 * {
                font-family: $font-liter !important;
                text-transform: lowercase;
                font-weight: 600;
                margin: 0;
            }
        }

        .left {
            display: flex;
            align-items: center;
            flex-direction: row-reverse;
            gap: 24px;

            a { text-decoration: none; }

            a.download {
                background: $dark-fg;
                padding: 10px 24px;
                border-radius: 24px;
                color: $fg;
            }
        }
    }
</style>
