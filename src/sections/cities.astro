---
import Map from "../components/map.astro";
import { cities } from "@strascrous/data";
import outlines from "../data/outlines.fr.json";

const stats = [
    { value: cities.length, label: "communes" },
    { value: new Set(cities.map((c) => c.academy)).size, label: "académies" },
    { value: outlines.overseas.length, label: "territoires d’Outre-mer" },
];
---

<section id="cities">
    <div class="container">
        <div class="left">
            <h2 class="highlight eyebrow">Partout en France</h2>
            <h3 class="tagline">Né à Strasbourg, disponible partout</h3>
            <p>À la base faite pour Strasbourg, l’application s’est ouverte à tout le pays : choisis ta ville, ton Resto U’ est là.</p>

            <dl class="stats">
                {stats.map(({ value, label }) => (
                    <div class="stat">
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                    </div>
                ))}
            </dl>
        </div>
        <div class="right">
            <Map cities={cities} highlight="strasbourg" />
        </div>
    </div>
</section>

<style lang="scss">
    section {
        container-type: inline-size;
    }

    .container {
        display: flex;
        align-items: center;
        gap: 56px;
        padding: 56px;
        background: rgba(255, 255, 255, .08);
        border-radius: 36px;
    }

    .left {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;

        p {
            max-width: 640px;
        }
    }

    .tagline {
        width: auto;
        max-width: 640px;
    }

    .stats {
        display: flex;
        gap: 40px;
        margin-top: 16px;
    }

    .stat {
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-end;
        gap: 4px;

        & + & {
            padding-left: 40px;
            border-left: 1px solid rgba(255, 255, 255, .15);
        }

        dd {
            font-size: 56px;
            font-weight: 700;
            line-height: 1;
            color: $highlight;
        }

        dt {
            font-size: 15px;
            opacity: .7;
        }
    }

    .right {
        flex: 0 1 448px;
        min-width: 0;
        margin-left: auto;
    }

    @container (max-width: 1040px) {
        .container {
            flex-direction: column;
            align-items: stretch;
            gap: 48px;
            padding: 48px;
        }

        .right {
            flex: none;
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
        }
    }

    @container (max-width: 720px) {
        .container {
            gap: 40px;
            padding: 36px 28px;
            border-radius: 28px;
        }

        .tagline {
            font-size: 36px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, auto);
            justify-content: start;
            gap: 20px;
            margin-top: 8px;
        }

        .stat {
            & + & {
                padding-left: 20px;
            }

            dd {
                font-size: 40px;
            }

            dt {
                font-size: 13px;
            }
        }
    }

    @container (max-width: 440px) {
        .container {
            gap: 32px;
            padding: 28px 20px;
            border-radius: 24px;
        }

        .left {
            gap: 16px;
        }

        .tagline {
            font-size: 28px;
        }

        .stats {
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .stat {
            & + & {
                padding-left: 12px;
            }

            dd {
                font-size: 32px;
            }

            dt {
                font-size: 12px;
            }
        }
    }
</style>
